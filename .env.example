# Configuração do AcademiaCloud. Copie para .env e TROQUE todas as senhas,
# ou gere tudo automaticamente:  sh scripts/gerar-env.sh
# Nunca publique o arquivo .env (ele está no .gitignore e no .dockerignore).

# --- Banco de dados
POSTGRES_DB=academia
# Conta ADMINISTRATIVA: usada só pelo init e pelo backup.
POSTGRES_ADMIN_USER=academia_admin
POSTGRES_ADMIN_PASSWORD=troque_senha_admin_do_banco
# Conta da APLICAÇÃO (menor privilégio: só lê/grava dados, sem DDL).
APP_DB_USER=academic_app
APP_DB_PASSWORD=troque_senha_app_do_banco
# Conta do serviço de NOTIFICAÇÕES (só acessa o schema notificacoes).
NOTIF_DB_USER=notificacoes_app
NOTIF_DB_PASSWORD=troque_senha_notificacoes

# --- Aplicação
# Chave que assina os cookies de sessão (igual em todas as réplicas).
SECRET_KEY=troque_por_texto_aleatorio_longo
# Senhas iniciais dos usuários admin, secretaria e professor.
ADMIN_PASSWORD=troque_senha_admin
SECRETARIA_PASSWORD=troque_senha_secretaria
PROFESSOR_PASSWORD=troque_senha_professor
APP_PORT=8080
WEB_REPLICAS=2
# true somente quando houver HTTPS na frente do balanceador.
COOKIE_SECURE=false

# --- Backup (Grupo 5)
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION=14
# UID/GID donos dos arquivos em ./backups (Linux: rode "id -u" e "id -g").
BACKUP_UID=1000
BACKUP_GID=1000

# --- pgAdmin (opcional: docker compose --profile admin up -d)
PGADMIN_PORT=5050
PGADMIN_EMAIL=professor@example.com
PGADMIN_PASSWORD=troque_senha_pgadmin
